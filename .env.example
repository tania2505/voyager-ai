PORT=3000
HOST=0.0.0.0
# Where sessions/holds are persisted (set PERSIST=false for memory only)
DATA_DIR=./data
PERSIST=true
SESSION_TTL_MIN=120
RATE_LIMIT_PER_MIN=60
# Set to your frontend origin if it is hosted elsewhere
CORS_ORIGIN=
# Optional: enables "Claude tool-use" mode
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-6
# LOG=silent to disable request logs
